# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here

# Model used for triage and repair calls (cheap model is enough for this task).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: set these from the official pricing page to get cost_usd in logs/eval.
# Leave commented out if you don't want cost tracking.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# Optional overrides (defaults shown)
# MAX_OUTPUT_TOKENS=400
# TEMPERATURE=0.0          # not sent unless set
# REQUEST_TIMEOUT_S=30
# RETRY_MAX_ATTEMPTS=4
# RETRY_BASE_DELAY_S=1.0
# RETRY_MAX_DELAY_S=20.0
# MAX_CONCURRENT_CALLS=4
# TRIAGE_PROMPT=triage_v1
# REPAIR_PROMPT=repair_v1

# Privacy: raw ticket text and raw model output are NOT logged unless this is true.
# LOG_RAW_CONTENT=false
